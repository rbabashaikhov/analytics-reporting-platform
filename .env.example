# Analytics Reporting Platform — Portfolio Edition
#
# Public-safe environment template. Copy to a private `.env` (never commit).
# Leave values empty here. Do not put real credentials in this file.

# ---------------------------------------------------------------------------
# PostgreSQL connection (execution target)
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# Canonical database names used by Monthly layers
RAW_DB_NAME=
CALC_DB_NAME=
CDM_DB_NAME=

# ---------------------------------------------------------------------------
# Adobe Analytics API
# ---------------------------------------------------------------------------
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_GLOBAL_COMPANY_ID=
ADOBE_REPORT_SUITE_ID=

# ---------------------------------------------------------------------------
# Monthly DWH validation (Airflow data_quality)
# ---------------------------------------------------------------------------
# Private runtime root for validation.md / validation.json (path only).
# Point at a writable directory outside the Git working tree.
ARP_VALIDATION_ARTIFACT_ROOT=

# Optional frozen/reference env file for secondary comparison (read-only).
ARP_REFERENCE_ENV_FILE=
